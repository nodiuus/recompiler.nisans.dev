# The backend loads this file from the repository root.
# Copy this file to .env before local development.

# Optional overrides:
# ADDR=:8080
# RECOMPILER_RAWPDB=./rawpdb-helper/build/bin/Release/rawpdb_analyzer.exe
# RECOMPILER_OBJDUMP=C:\Program Files\LLVM\bin\llvm-objdump.exe
# RECOMPILER_PATH=./recompiler/remill_recompiler.exe
# RECOMPILER_LOG_FILE=C:\ProgramData\recompiler\logs\backend.log
# RECOMPILER_MAX_UPLOAD_MIB=1024
# RECOMPILER_CACHE_MIB=4096
# RECOMPILER_ANALYSIS_WORKERS=16
# RECOMPILER_ANALYSIS_JOBS=1

# RECOMPILER_PATH is required only for transformations. The transformation
# executable and its Remill/LLVM runtime files are not included in this
# repository. See backend/README.md for the supported tool-path overrides.

# Datadog APM and continuous profiling. The backend sends both to the local Agent.
# DD_TRACE_ENABLED=true
# DD_PROFILING_ENABLED=true
# DD_AGENT_HOST=127.0.0.1
# DD_TRACE_AGENT_PORT=8126
# DD_TRACE_STARTUP_LOGS=false
# DD_SERVICE=binary-analysis-api
# DD_ENV=development
# DD_VERSION=dev
