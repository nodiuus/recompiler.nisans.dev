# Copy this file to .env.local. Vite exposes all VITE_ values to the browser.
# Use a Datadog RUM client token here. Do not put a Datadog API key in this file.
VITE_DD_RUM_APPLICATION_ID=
VITE_DD_RUM_CLIENT_TOKEN=
VITE_DD_SITE=datadoghq.com
VITE_DD_SERVICE=binary-analysis-web
VITE_DD_ENV=development
VITE_DD_VERSION=dev
VITE_DD_SESSION_SAMPLE_RATE=100
VITE_DD_TRACE_SAMPLE_RATE=100

# Leave this empty when the frontend and API use the same origin.
# VITE_API_URL=http://localhost:8080
